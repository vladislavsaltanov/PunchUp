  tooltips:
  - "<color=#C7C7C7>WASD</color> - \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\\n<color=#C7C7C7>\u041B\u0435\u0432\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u044B\u0448\u0438 | \u041B</color>
    - \u0430\u0442\u0430\u043A\u0430\\n<color=#C7C7C7>\u041F\u0440\u0430\u0432\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u044B\u0448\u0438 | \u0414</color>
    - \u0441\u043F\u0435\u0446. \u0430\u0442\u0430\u043A\u0430\\n<color=#C7C7C7>\u0428\u0438\u0444\u0442</color>
    - \u0434\u044D\u0448\\n<color=#C7C7C7>\u041F\u0440\u043E\u0431\u0435\u043B</color>
    - \u043F\u0440\u044B\u0436\u043E\u043A\\n<color=#C7C7C7>Tab</color> - \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\\n<color=#C7C7C7>Esc</color>
    - \u043F\u0430\u0443\u0437\u0430\\n"
  - "\u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u043D\u0430 <color=#C7C7C7>E</color>, \u043F\u0440\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0439
    \u0441\u0432\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438."
  - "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 <color=#C7C7C7>\u043B\u0438\u0444\u0442</color>
    \u0438 \u0434\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E <color=#C7C7C7>\u044D\u0442\u0430\u0436\u0430</color>."
  - "<color=#858585>\u0423\u0434\u0430\u0447\u0438 :)</color> "
  delay: 2
